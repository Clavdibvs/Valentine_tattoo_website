# ============================================================================
# Valentine Tattoo — environment template
#
# Copy to `.env.local` and fill in. NEVER commit real values.
# `.env.local` is git-ignored by default.
#
# Only variables prefixed with NEXT_PUBLIC_ reach the browser. Everything else
# stays on the server.
# ============================================================================


# ----------------------------------------------------------------------------
# WhatsApp  (public — used to build the wa.me link)
# ----------------------------------------------------------------------------
# International format, digits only, no "+", no spaces.
# Example for an Italian mobile: 39XXXXXXXXXX
#
# Leave empty and the site simply hides the WhatsApp buttons and offers
# Instagram instead. It never links to a placeholder number.
#
# NOTE: NEXT_PUBLIC_* variables are inlined at BUILD time. This value must be
# present when `next build` runs — changing it later requires a redeploy, not
# just a restart. The server-side variables below are read at runtime.
NEXT_PUBLIC_WHATSAPP_NUMBER=


# ----------------------------------------------------------------------------
# Instagram  (SERVER ONLY — never prefix these with NEXT_PUBLIC_)
# ----------------------------------------------------------------------------
# Instagram API with Instagram Login. Requires a Professional
# (Business or Creator) Instagram account — personal accounts cannot be used.
# See README → "Connecting the Instagram account".

# Numeric Instagram user id of @valentine.ttt
INSTAGRAM_USER_ID=

# Long-lived Instagram User access token (valid ~60 days, must be refreshed).
INSTAGRAM_ACCESS_TOKEN=

# Graph API version. Bump when Meta publishes a new stable version.
INSTAGRAM_API_VERSION=v25.0

# How many recent media items to request (1–25). One request feeds the Instagram
# section AND the three collections below, so keep it generous.
INSTAGRAM_FEED_LIMIT=25


# ----------------------------------------------------------------------------
# Collections: Creazioni, Flash, Merch  (SERVER ONLY, all optional)
#
# Instagram's official API exposes NO story-highlights edge, so these three
# sections are built from the real feed, selected by a marker in the caption.
# Valentina tags a post once and it lands in the right section — no code change.
#
# Defaults (in src/config/site-config.ts) already cover the obvious words, e.g.
# "#flash" for FLASH. Override only if she uses different tags.
# ----------------------------------------------------------------------------

# Comma-separated hashtags or keywords. Matched case-insensitively, on whole
# words, with or without the leading "#".
INSTAGRAM_CREAZIONI_TAGS=
INSTAGRAM_FLASH_TAGS=
INSTAGRAM_MERCH_TAGS=

# Full manual control: comma-separated media ids. When set, the tags above are
# ignored for that collection and exactly these posts are shown, in this order.
INSTAGRAM_CREAZIONI_MEDIA_IDS=
INSTAGRAM_FLASH_MEDIA_IDS=
INSTAGRAM_MERCH_MEDIA_IDS=

# Needed only to run the token refresh script (`npm run instagram:refresh`)
# and to exchange a short-lived token for a long-lived one.
INSTAGRAM_APP_SECRET=


# ----------------------------------------------------------------------------
# Consultation form delivery  (SERVER ONLY)
#
# Configure EXACTLY ONE transport. If neither is set, the form refuses
# submissions and says so — it never fakes a success.
# ----------------------------------------------------------------------------

# Option A — POST the request as JSON to any endpoint
# (Make, Zapier, n8n, a Google Apps Script, your own API…).
CONSULTATION_WEBHOOK_URL=

# Option B — send it as an email through a provider HTTP API.
CONSULTATION_RECIPIENT_EMAIL=
# Defaults to Resend's endpoint; point it at another provider if you prefer.
CONTACT_PROVIDER_API_URL=https://api.resend.com/emails
# Verified sender for the chosen provider.
CONSULTATION_SENDER_EMAIL=

# Bearer token for whichever of the two options you picked.
CONTACT_PROVIDER_API_KEY=


# ----------------------------------------------------------------------------
# Reference-image storage  (SERVER ONLY, optional)
#
# When unset, uploaded references are still validated and their metadata is
# delivered with the request — only the binaries are not persisted.
# ----------------------------------------------------------------------------
UPLOAD_STORAGE_BUCKET=
UPLOAD_STORAGE_ENDPOINT=
UPLOAD_STORAGE_TOKEN=
