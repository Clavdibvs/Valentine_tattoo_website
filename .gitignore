# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is the committed template, real values never are
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source art and media exports. Kept locally; only the optimized derivatives in
# public/backdrops, public/brand and public/gallery are versioned. See ASSETS.md.
/design-references/
/new references/
/public/instagram-media/
/VIDEO INIZIALI/
.gallery-tmp/

# Rendered section captures — 27 MB of 4K PNGs that nothing on the site loads.
# They are regenerated from the running app, not authored, so the repo does not
# need to carry them.
/SCREENSHOT SEZIONI/

# Promo video: captures of the running site and render intermediates are
# regenerated by promo/scripts (see promo/README.md); only the delivered
# video is versioned.
/promo/captures/
/promo/.cache/
